{
  "name": "ficou_claro",
  "version": "0.0.1",
  "description": "A Quasar Project",
  "productName": "Ficou Claro?",
  "author": "VictorSoares98 <luan.victtor@hotmail.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "prettier --write \"**/*.{js,ts,vue,css,scss,html,md,json}\" --ignore-path .gitignore && eslint --fix -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "lint:check": "prettier \"**/*.{js,ts,vue,css,scss,html,md,json}\" --ignore-path .gitignore && eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "dev": "npm run db:start && quasar dev",
    "build": "quasar build",
    "build:android": "dotenv -e .env.production -- quasar build -m capacitor -T android",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "quasar prepare --silent",
    "db:build": "node supabase/build-schema.js"
  },
  "dependencies": {
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@quasar/extras": "^2.0.3",
    "@supabase/supabase-js": "^2.112.3",
    "echarts": "^6.1.0",
    "pinia": "^4.0.2",
    "quasar": "^2.25.0",
    "vue": "^3.5.22",
    "vue-echarts": "^8.1.0",
    "vue-i18n": "^11.3.0",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@intlify/unplugin-vue-i18n": "^11.0.0",
    "@quasar/app-vite": "^3.6.1",
    "@types/node": "^22.19.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "autoprefixer": "^10.4.27",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.0",
    "vite-plugin-checker": "^0.14.5",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.3.3"
  },
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-cli",
    "quasar-app-vite",
    "vite",
    "vue",
    "vuejs"
  ],
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  }
}
